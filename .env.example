# Server Configuration
PORT=8000

# Admin Authentication
ADMIN_KEY=admin123456

# Optional downstream API keys (injected from environment, not written to database)
# API_KEYS=g2a_key1,g2a_key2

# Database
DATABASE_PATH=./data/grok2api.db

# Frontend Static Files
FRONTEND_DIST=./frontend/dist

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
